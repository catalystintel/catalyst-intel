# =============================================================================
# LOCAL DEV (machines with SQLite)
# Copy to .env.local and fill in. Do not commit .env.local.
# =============================================================================

# Local SQLite file via the libSQL driver. Leave as-is for local machines.
# Staging/production use Turso instead (LIBSQL_URL + LIBSQL_AUTH_TOKEN on Vercel).
DATABASE_URL=file:./local.db

# How often `npm run cron` re-fetches data locally (minutes). Default: 2.
# CRON_INTERVAL_MINUTES=2

# Supabase Auth (Google OAuth only - no passwords stored in our DB).
# Project Settings -> API. Enable Google under Authentication -> Providers.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# PostHog product analytics (optional). Leave blank to disable — the app no-ops.
# Create a project at https://posthog.com → Project settings → Project API key.
# US Cloud host: https://us.i.posthog.com  |  EU Cloud: https://eu.i.posthog.com
# Prefer NEXT_PUBLIC_POSTHOG_KEY; NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN is accepted as a fallback.
NEXT_PUBLIC_POSTHOG_KEY=
# NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# SEC requires a descriptive User-Agent on every request.
# Format: "<contact email> <app name>/<version>"
SEC_EDGAR_USER_AGENT=you@example.com CatalystIntel/0.1

# Admin panel + manual fetch API (comma-separated emails).
# Defaults (if unset): zhbar10@gmail.com,omer.nachshon@gmail.com
# Checked against the verified Supabase session email — not a client flag.
# ADMIN_EMAILS=zhbar10@gmail.com,omer.nachshon@gmail.com

# Local-only auth bypass: skip Google OAuth entirely and browse as a signed-in
# user. Handy when localhost OAuth bounces to the deployed Site URL. NEVER takes
# effect in production (guarded by NODE_ENV). Defaults the user to the first
# ADMIN_EMAILS entry; override with DEV_AUTH_EMAIL.
# DEV_AUTH_BYPASS=true
# DEV_AUTH_EMAIL=omer.nachshon@gmail.com

# API rate limits are in-memory per server isolate (see DEPLOYMENT.md).
# No Redis/Upstash required for MVP. Cron (`x-cron-secret`) bypasses limits.

# Optional / later phases (not required for local MVP):
# SUPABASE_SERVICE_ROLE_KEY=
# CRON_SECRET=
# GROQ_API_KEY=
#
# Required on Vercel (Preview + Production). Local file SQLite cannot run on
# serverless — without these, /dashboard crashes after Google login.
# LIBSQL_URL=
# LIBSQL_AUTH_TOKEN=
