# =============================================================================
# LOCAL DEV (machines with SQLite)
# Copy to .env.local and fill in. Do not commit .env.local.
# =============================================================================

# Local SQLite file via the libSQL driver. Leave as-is for local machines.
# Staging/production use Turso instead (LIBSQL_URL + LIBSQL_AUTH_TOKEN on Vercel).
DATABASE_URL=file:./local.db

# How often `npm run cron` re-fetches data locally (minutes). Default: 2.
# CRON_INTERVAL_MINUTES=2

# Supabase Auth (Google OAuth only - no passwords stored in our DB).
# Project Settings -> API. Enable Google under Authentication -> Providers.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# PostHog product analytics (optional). Leave blank to disable — the app no-ops.
# Create a project at https://posthog.com → Project settings → Project API key.
# US Cloud host: https://us.i.posthog.com  |  EU Cloud: https://eu.i.posthog.com
# Prefer NEXT_PUBLIC_POSTHOG_KEY; NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN is accepted as a fallback.
NEXT_PUBLIC_POSTHOG_KEY=
# NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# SEC requires a descriptive User-Agent on every request.
# Format: "<contact email> <app name>/<version>"
SEC_EDGAR_USER_AGENT=you@example.com CatalystIntel/0.1

# Admin panel + manual fetch API (comma-separated emails).
# Defaults (if unset): zhbar10@gmail.com,omer.nachshon@gmail.com
# Checked against the verified Supabase session email — not a client flag.
# ADMIN_EMAILS=zhbar10@gmail.com,omer.nachshon@gmail.com

# Local-only auth bypass: skip Google OAuth entirely and browse as a signed-in
# user. Handy when localhost OAuth bounces to the deployed Site URL. NEVER takes
# effect in production (guarded by NODE_ENV). Defaults the user to the first
# ADMIN_EMAILS entry; override with DEV_AUTH_EMAIL.
# DEV_AUTH_BYPASS=true
# DEV_AUTH_EMAIL=omer.nachshon@gmail.com

# API rate limits are in-memory per server isolate (see DEPLOYMENT.md).
# No Redis/Upstash required for MVP. Cron (`x-cron-secret`) bypasses limits.

# Optional / later phases (not required for local MVP):
# SUPABASE_SERVICE_ROLE_KEY=
# CRON_SECRET=

# OpenRouter — on-demand AI analysis (free `:free` models). Get a key at
# https://openrouter.ai/keys — put it in .env.local and restart `npm run dev`.
# Single key:
# OPENROUTER_API_KEY=sk-or-v1-...
# Or stack free quotas with a comma-separated pool (round-robin + 429 failover):
# OPENROUTER_API_KEYS=sk-or-v1-aaa,sk-or-v1-bbb
# Optional model override (default: openai/gpt-oss-20b:free)
# OPENROUTER_MODEL=openai/gpt-oss-20b:free
# Optional app URL for OpenRouter rankings / referer header:
# NEXT_PUBLIC_APP_URL=http://localhost:3000

# Alert delivery (JTBD 4). Webhook and Web Push rules work without any of these.
#
# Email rules need RESEND_API_KEY. Resend cannot send "from" a gmail.com (or
# any domain you don't control/verify) — use the free sandbox sender unless
# you own+verify a domain in Resend.
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=Catalyst Intel <onboarding@resend.dev>
# Product feedback inbox (bugs / feature requests / improvements via /api/feedback).
# Defaults to catalyst.intel.feedback@gmail.com when unset. This is fine to be
# a gmail.com address — it's only ever the *receiving* inbox, not a From.
# FEEDBACK_TO_EMAIL=catalyst.intel.feedback@gmail.com

# Web Push — primary alert channel. Free forever, no FCM/APNs account,
# delivers even when the tab/browser is closed. Generate once with:
#   npx web-push generate-vapid-keys
# Public key is read client-side too (NEXT_PUBLIC_ mirror is required).
# WEB_PUSH_VAPID_PUBLIC_KEY=
# WEB_PUSH_VAPID_PRIVATE_KEY=
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# WEB_PUSH_CONTACT_EMAIL=you@example.com

# Telegram bot — free, no per-message cost. Create one via @BotFather on
# Telegram (/newbot), paste the token below. Users message the bot once to
# get a chat_id, then paste it into an alert rule.
# TELEGRAM_BOT_TOKEN=

# Finnhub — earnings/FDA calendars + company news + recommendation trends / price targets.
# Get a key at https://finnhub.io — soft-fails when unset.
# FINNHUB_API_KEY=

# PR wire — keyless public high-impact board by default (no env needed).
# Optional authenticated full-feed upgrade (otherwise unused):
# PR_WIRE_API_KEY=
# PR_WIRE_API_BASE=

# Polygon / Massive — Benzinga-style news + historical_impact price enrichment.
# Get a key at https://polygon.io (Massive). Soft-fails when unset.
# POLYGON_API_KEY=
# MASSIVE_API_KEY=   # accepted as an alias for POLYGON_API_KEY

# Form4API — optional Form 4 enrichment (SEC EDGAR type=4 still works without it).
# Free tier (500 req/day): https://www.form4api.com — paste key as FORM4_API_KEY.
# FORM4_API_KEY=

# Keyless sources (always attempted): SEC EDGAR, Nasdaq Trader halts RSS,
# openFDA, ClinicalTrials.gov, and embedded US macro calendar (CPI/NFP/FOMC).
#
# Required on Vercel (Preview + Production). Local file SQLite cannot run on
# serverless — without these, /dashboard crashes after Google login.
# LIBSQL_URL=
# LIBSQL_AUTH_TOKEN=
