# Local SQLite database file (Drizzle ORM, via the libSQL driver). Leave as-is
# for local dev - in production this is replaced by LIBSQL_URL/LIBSQL_AUTH_TOKEN
# pointing at a hosted Turso database instead (see DEPLOYMENT.md).
DATABASE_URL=file:./local.db
# LIBSQL_URL=
# LIBSQL_AUTH_TOKEN=

# How often `npm run cron` re-fetches data locally (minutes). Default: 2.
# CRON_INTERVAL_MINUTES=2

# Supabase project (used for Auth only - not app data).
# Create a free project at https://supabase.com, enable Email auth,
# then copy these from Project Settings -> API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional - only needed for future server-side admin operations against
# Supabase's own user management API (not required for the current MVP).
# SUPABASE_SERVICE_ROLE_KEY=

# Shared secret allowing the production GitHub Actions cron to trigger data
# ingestion without a browser session. Only required in production - see
# DEPLOYMENT.md. Generate any long random string, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# CRON_SECRET=

# SEC requires a descriptive User-Agent identifying you on every request.
# Format: "<contact email> <app name>/<version>"
SEC_EDGAR_USER_AGENT=you@example.com CatalystIntel/0.1

# Used later once AI classification/scoring is added (Groq hosting Qwen3-32B).
# Sign up free at https://console.groq.com - no credit card required.
# GROQ_API_KEY=
