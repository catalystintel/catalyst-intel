# =============================================================================
# LOCAL DEV (machines with SQLite)
# Copy to .env.local and fill in. Do not commit .env.local.
# =============================================================================

# Local SQLite file via the libSQL driver. Leave as-is for local machines.
# Staging/production use Turso instead (LIBSQL_URL + LIBSQL_AUTH_TOKEN on Vercel).
DATABASE_URL=file:./local.db

# How often `npm run cron` re-fetches data locally (minutes). Default: 2.
# CRON_INTERVAL_MINUTES=2

# Supabase Auth (Google OAuth only - no passwords stored in our DB).
# Project Settings -> API. Enable Google under Authentication -> Providers.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SEC requires a descriptive User-Agent on every request.
# Format: "<contact email> <app name>/<version>"
SEC_EDGAR_USER_AGENT=you@example.com CatalystIntel/0.1

# Optional / later phases (not required for local MVP):
# SUPABASE_SERVICE_ROLE_KEY=
# CRON_SECRET=
# GROQ_API_KEY=
# LIBSQL_URL=
# LIBSQL_AUTH_TOKEN=
